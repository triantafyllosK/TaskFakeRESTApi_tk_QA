{
  "name": "fakerestapi-bookstore-api-tests",
  "version": "1.0.0",
  "private": true,
  "description": "Production-oriented API automation framework for the FakeRestAPI Books endpoints.",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:contract": "playwright test --grep @contract",
    "test:negative": "playwright test --grep @negative",
    "test:workflow": "playwright test --grep @workflow",
    "test:robustness": "playwright test --grep @robustness",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "report:generate": "node scripts/clean-allure-report.mjs && allure generate allure-results --output allure-report",
    "report:open": "allure open allure-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "allure": "3.18.0",
    "allure-js-commons": "3.12.1",
    "allure-playwright": "3.12.1",
    "dotenv": "17.4.2",
    "eslint": "10.10.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
