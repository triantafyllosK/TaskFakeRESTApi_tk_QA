# Copy this file to .env for local convenience. CI should inject the same
# variables directly and must not rely on a committed .env file.
#
# BASE_URL is the FakeRestAPI origin without a trailing slash.
BASE_URL=https://fakerestapi.azurewebsites.net
#
# TEST_ENV is a label used in Allure environment info (local | qa | staging | ci).
TEST_ENV=local
